# ─────────────────────────────────────────────────────────────────────────────
# HALO World Global Platform — environment variable reference
#
# Copy this file to .env and fill in the values for local development.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Netlify Identity ─────────────────────────────────────────────────────────
# Automatically set by Netlify when Identity is enabled on the site.
# For local dev with netlify-cli this is handled automatically.
# NETLIFY_IDENTITY_URL=https://<your-site-name>.netlify.app

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string provided by Netlify (or a local Postgres instance
# for development). Used by Drizzle ORM and @netlify/database.
DATABASE_URL=******localhost:5432/halo_dev

# ── Statistics admin token ───────────────────────────────────────────────────
# A secret ****** that protects the /api/stats-summary and
# /api/radio-audience admin endpoints. Generate with:
#   openssl rand -hex 32
STATS_ADMIN_TOKEN=replace_with_a_long_random_secret

# ── OpenAI ───────────────────────────────────────────────────────────────────
# API key for the HALO agent council and AI DJ features.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Netlify Blobs ─────────────────────────────────────────────────────────────
# Automatically injected by Netlify in production.
# For local dev with netlify-cli the values are set automatically.
# NETLIFY_BLOBS_CONTEXT=...

# ── Site URL (used by maintenance checks and link verification) ───────────────
SITE_URL=https://your-site.netlify.app
