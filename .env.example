# ─────────────────────────────────────────────────────────────────────────────
# HALO World Global Platform — environment variable reference
#
# Copy this file to .env and fill in the values for local development.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Netlify Identity ─────────────────────────────────────────────────────────
# Automatically set by Netlify when Identity is enabled on the site.
# For local dev with netlify-cli this is handled automatically.
# NETLIFY_IDENTITY_URL=https://<your-site-name>.netlify.app

# ── Empath Journey ────────────────────────────────────────────────────────────
# Server-only HMAC secret for pseudonymous votes and ledger interaction actors.
# Generate with openssl rand -hex 32. JWT_SECRET is accepted as a fallback.
# Keep this stable: rotating it resets account vote deduplication.
JOURNEY_IDENTITY_SECRET=
# Emergency moderation switch; public reading and saved share links stay available.
JOURNEY_WRITES_DISABLED=false

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string provided by Netlify (or a local Postgres instance
# for development). Used by Drizzle ORM and @netlify/database.
DATABASE_URL=******localhost:5432/halo_dev

# ── Statistics admin token ───────────────────────────────────────────────────
# A secret ****** that protects the /api/stats-summary and
# /api/radio-audience admin endpoints. Generate with:
#   openssl rand -hex 32
STATS_ADMIN_TOKEN=replace_with_a_long_random_secret

# ── OpenAI ───────────────────────────────────────────────────────────────────
# API key for the HALO agent council and AI DJ features.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Netlify Blobs ─────────────────────────────────────────────────────────────
# Automatically injected by Netlify in production.
# For local dev with netlify-cli the values are set automatically.
# NETLIFY_BLOBS_CONTEXT=...

# ── Direct master-copy storage (optional) ─────────────────────────────────────
# S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO, Supabase S3)
# used for direct browser uploads of large sale-master WAV/M4A files (up to 200 MB).
# When unset, master copies fall back to the chunked Netlify Blobs upload (128 MB).
# The bucket must stay private and allow CORS PUT/GET/HEAD from the site origin
# with the Content-Type header. ENDPOINT is only needed for non-AWS providers.
# HALO_MASTER_STORAGE_BUCKET=halo-masters
# HALO_MASTER_STORAGE_REGION=us-east-1
# HALO_MASTER_STORAGE_ACCESS_KEY_ID=
# HALO_MASTER_STORAGE_SECRET_ACCESS_KEY=
# HALO_MASTER_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# HALO_MASTER_STORAGE_FORCE_PATH_STYLE=true

# ── Google Drive master archive (optional) ────────────────────────────────────
# Service account used by /api/upload/drive-session to open resumable upload sessions
# so the browser can stream WAV masters (up to 2000 MB) to Drive in 5 MB chunks.
# Share the masters folder (or its shared drive) with the service account as Editor.
# Provide either the full key JSON or the email + private key pair.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=halo-masters@<project>.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_MASTERS_FOLDER_ID=
#
# Public curated playback reuses these same server-only credentials and masters folder.
# Put exactly ONE catalog-index.json (maximum 1 MiB) directly in that folder.
# Every referenced audio file must also be directly in that folder, nontrashed and nonempty.
# Only tracks explicitly marked public:true are published; drafts/missing flags are excluded.
# Index example (all five energy levels: Warm-up Groove, Build-up, Fresh Drop,
# Crowd-Lifter, Peak Anthemic; rotationStatus: Fresh, Active, Used-Recently):
# {"version":1,"tracks":[{"id":"example-track","title":"Example","artist":"HALO",
# "bpm":120,"durationSeconds":180,"energyLevel":"Build-up","rotationStatus":"Fresh",
# "driveFileId":"YOUR_DRIVE_AUDIO_FILE_ID","public":true}]}
# Optional track fields: releasedAt / lastPlayedAt (ISO dates), primaryAudioPath
# (existing public audio path), genre, and tags (up to 12 short mood/style words such
# as ["warm","cinematic"]) used by Dreamweaver mix requests (see DREAMWEAVER_MIX_REQUESTS.md). Private Drive audio is streamed through an allowlisted
# /api/drive-catalog/audio?track=... fallback, never through public Drive share links.
# Catalog validation is cached for 60 seconds; allow up to 60 seconds for removals.
# Missing Drive configuration keeps the existing public catalog in use; configured
# ingestion failures return a friendly 503 rather than silently replacing the catalog.
# Partial/invalid Drive credentials or folder settings also fail closed with 503.

# ── Site URL (used by maintenance checks and link verification) ───────────────
SITE_URL=https://your-site.netlify.app
